# ============================================================
#  Shield Bot – Environment Variables
#  Copy this file to .env and fill in all required values.
#  Required on Railway: add each variable under Variables tab.
# ============================================================

# ── Telegram API credentials (required) ─────────────────────
# Obtain from https://my.telegram.org → API development tools
API_ID=
API_HASH=

# ── Bot token (required) ─────────────────────────────────────
# Obtain from @BotFather on Telegram
BOT_TOKEN=

# ── Force-subscribe channel (required) ───────────────────────
# Username of the channel/group users must join (e.g. @mychannel)
CHANNEL=

# ── Welcome messages (required) ──────────────────────────────
# Supports placeholders: {mention} {title} {fullname} {username}
#                        {name} {last} {channel} {count}
WELCOME_MSG=Welcome {mention}! Glad to see you in {title}.
WELCOME_NOT_JOINED=Hey {mention}, please join {channel} first to participate.

# ── Behaviour flags (required) ────────────────────────────────
# Set to True or False (case-insensitive)
ON_JOIN=True
ON_NEW_MSG=True

# ── Telethon string session (REQUIRED on Railway / any cloud) ─
# File-based sessions are lost on every redeploy.
# Generate one locally by running: python3 generate_session.py
# Then paste the printed string here.
SESSION_STRING=

# ── Database (optional – auto-provided by Railway PostgreSQL) ─
# If set, PostgreSQL is used instead of local SQLite.
# Railway sets this automatically when you add a Postgres plugin.
DATABASE_URL=

# ── GitHub sync (optional – Replit only) ─────────────────────
# Personal Access Token used to push changes to GitHub.
GITHUB_TOKEN=
